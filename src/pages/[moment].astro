---
// One page per moment after the first, e.g. /cobra/. Each is the full atlas,
// opening directly on that moment.
import Base from '../layouts/Base.astro';
import Atlas from '../components/Atlas.astro';
import { loadContent } from '../lib/load';
import { momentDescription, momentTitle } from '../lib/meta';

export async function getStaticPaths() {
  const { scenes } = await loadContent();
  return scenes.slice(1).map((sc, i) => ({ params: { moment: sc.id }, props: { index: i + 1 } }));
}

const { index } = Astro.props;
const { scenes } = await loadContent();
const sc = scenes[index];
---
<Base title={momentTitle(sc, index)} description={momentDescription(sc, index)} path={`${sc.id}/`}
  image={`og/${sc.id}.png`} imageAlt={`Map: ${sc.title}, ${sc.date}`} bodyClass="atlas" preloadMap>
  <Atlas scenes={scenes} index={index} />
</Base>
