---
// Front page: the title over the globe. Starting the story moves to /eve/.
import Base from '../layouts/Base.astro';
import Atlas from '../components/Atlas.astro';
import { loadContent } from '../lib/load';
import { coverDescription, coverTitle } from '../lib/meta';

const { scenes } = await loadContent();
---
<Base title={coverTitle()} description={coverDescription()} path="" image="og/cover.png"
  imageAlt="Normandy, 1944: an animated atlas of the Battle of Normandy" bodyClass="atlas at-cover" preloadMap>
  <Atlas scenes={scenes} index={-1} />
</Base>
