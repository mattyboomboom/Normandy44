---
// Home page: the atlas, opening on the first moment (the eve of D-Day).
import Base from '../layouts/Base.astro';
import Atlas from '../components/Atlas.astro';
import { loadContent } from '../lib/load';
import { momentDescription, momentTitle } from '../lib/meta';

const { scenes } = await loadContent();
const sc = scenes[0];
---
<Base title={momentTitle(sc, 0)} description={momentDescription(sc, 0)} path="" image={`og/${sc.id}.png`}
  imageAlt={`Map: ${sc.title}`} bodyClass="atlas at-intro" preloadMap>
  <Atlas scenes={scenes} index={0} />
</Base>
