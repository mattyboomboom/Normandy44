---
// The whole campaign as plain text: every moment's story and figures, in
// order. For reading without the map, for screen readers and for search engines.
import Page from '../layouts/Page.astro';
import { loadContent } from '../lib/load';
import { firstSteps, momentOf } from '../lib/content';
import { figureHref, momentPath, scenePath } from '../lib/site';
import { dayLabel, fullDate, forcesHeading } from '../atlas/panel';
import { NAT, NAT_NAME } from '../data/nations';
import type { Scene } from '../data/types';

const { scenes } = await loadContent();
const moments = firstSteps(scenes);
const stepsOf = (sc: Scene) => sc.step ? scenes.filter(s => s.step?.moment === sc.step!.moment) : [sc];
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : `${Math.floor(n)}½`);
---
<Page title={`The story in ${moments.length} moments`} path="story/"
  description="The Battle of Normandy, 5 June to 30 August 1944, told moment by moment: the landings, the fight for Caen and the bocage, the breakout, the Falaise pocket and the liberation of Paris.">
  <div class="prose">
    <h1>The story in {moments.length} moments</h1>
    <p class="lede">The Battle of Normandy as text, from the eve of D-Day to the crossing of the Seine. Each moment links to its view on the map.</p>
    <nav aria-label="Moments" class="small">
      <ol>
        {moments.map(sc => <li><a href={`#${momentOf(sc)}`}>{sc.title}</a> <span class="dim">({dayLabel(sc.day)})</span></li>)}
      </ol>
    </nav>

    {moments.map(sc => {
      const id = momentOf(sc);
      const steps = stepsOf(sc);
      const last = steps[steps.length - 1];
      return (
        <article class="moment" id={id} aria-labelledby={`h-${id}`}>
          <p class="when"><b>{dayLabel(sc.day)}</b>{sc.step ? `${sc.date} – ${last.date}` : fullDate(sc)}</p>
          <h2 id={`h-${id}`}>{sc.title}</h2>
          {steps.map(st => (
            <>
              {st.step && <h3>{st.step.n}. {st.step.title} <span class="dim small">{fullDate(st)}</span></h3>}
              {st.body.map(p => <p>{p}</p>)}
              {st.step && <p class="onmap small"><a href={scenePath(st)}>See this step on the map</a></p>}
            </>
          ))}
          {sc.armour && (
            <p class="small dim">German armoured divisions facing the British and Canadians, {sc.armour.when}: {sc.armour.br === null ? 'not recorded' : fmt(sc.armour.br)}; facing the Americans: {sc.armour.us === null ? 'not recorded' : fmt(sc.armour.us)}.</p>
          )}
          {sc.forces && sc.forces.length > 0 && (
            <table class="figs">
              <caption>{forcesHeading(sc)}</caption>
              <tbody>
                {sc.forces.map((f, j) => (
                  <tr>
                    <th scope="row">
                      <span class="sw" style={`background:${NAT[f.n]}`} title={NAT_NAME[f.n]}></span>{f.k}
                      {f.s && <span class="s">{f.s}</span>}
                    </th>
                    <td class="v">
                      {f.v}
                      {f.check && <a class:list={['cite', { unv: f.check === 'unverified' }]} href={figureHref(id, j)}>{f.check === 'verified' ? 'source' : 'unverified'}</a>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          {!sc.step && <p class="onmap"><a href={momentPath(id)}>See this moment on the map</a></p>}
        </article>
      );
    })}
  </div>
</Page>
