---
// Layout for the reading pages (story, about, sources).
import Base from './Base.astro';
import '../styles/page.css';
import { withBase } from '../lib/url';
import { SITE_NAME } from '../lib/site';

interface Props { title: string; description: string; path: string; image?: string }
const { title, description, path, image } = Astro.props;
const links = [
  { href: withBase('/'), label: 'The map', match: '' },
  { href: withBase('story/'), label: 'Read the story', match: 'story/' },
  { href: withBase('about/'), label: 'About', match: 'about/' },
  { href: withBase('sources/'), label: 'Sources', match: 'sources/' }
];
---
<Base title={`${title} · ${SITE_NAME}`} description={description} path={path} image={image}>
  <header class="site-head">
    <div class="in">
      <a class="brand" href={withBase('/')}>{SITE_NAME}</a>
      <nav aria-label="Site">
        {links.map(l => <a href={l.href} aria-current={l.match === path ? 'page' : undefined}>{l.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-foot">
    <div class="in">
      Areas of control and front lines are simplified and approximate. Figures are rounded and sourced on the <a href={withBase('sources/')}>Sources</a> page.
    </div>
  </footer>
</Base>
